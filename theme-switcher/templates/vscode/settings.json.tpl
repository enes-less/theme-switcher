    "editor.tokenColorCustomizations": {
        "comments": "{{overlay}}",
        "textMateRules": [
        {
            "scope": ["comment", "punctuation.definition.comment"],
            "settings": {
            "foreground": "{{overlay}}",
            "fontStyle": "italic"
            }
        },
        {
            "scope": ["string", "string.quoted", "string.template", "punctuation.definition.string"],
            "settings": {
            "foreground": "{{green}}"
            }
        },
        {
            "scope": ["constant.numeric", "constant.language.boolean", "constant.character", "constant.other"],
            "settings": {
            "foreground": "{{orange}}"
            }
        },
        {
            "scope": ["keyword", "keyword.control", "storage", "storage.type"],
            "settings": {
            "foreground": "{{mauve}}",
            "fontStyle": "bold"
            }
        },
        {
            "scope": ["entity.name.function", "support.function", "meta.function-call", "variable.function"],
            "settings": {
            "foreground": "{{blue}}"
            }
        },
        {
            "scope": ["entity.name.type", "entity.name.class", "entity.name.namespace", "support.type"],
            "settings": {
            "foreground": "{{yellow}}"
            }
        },
        {
            "scope": ["variable", "meta.definition.variable", "support.variable"],
            "settings": {
            "foreground": "{{fg}}"
            }
        },
        {
            "scope": ["variable.parameter"],
            "settings": {
            "foreground": "{{orange}}"
            }
        },
        {
            "scope": ["variable.language", "variable.other.constant"],
            "settings": {
            "foreground": "{{red}}"
            }
        },
        {
            "scope": ["entity.name.tag", "meta.tag", "punctuation.definition.tag"],
            "settings": {
            "foreground": "{{blue}}"
            }
        },
        {
            "scope": ["entity.other.attribute-name"],
            "settings": {
            "foreground": "{{teal}}"
            }
        },
        {
            "scope": ["support.constant.property-value", "constant.other.color"],
            "settings": {
            "foreground": "{{pink}}"
            }
        },
        {
            "scope": ["punctuation", "meta.brace", "meta.delimiter"],
            "settings": {
            "foreground": "{{fg_dim}}"
            }
        },
        {
            "scope": ["invalid", "invalid.illegal"],
            "settings": {
            "foreground": "{{red}}",
            "fontStyle": "underline"
            }
        },
        {
            "scope": ["markup.heading"],
            "settings": {
            "foreground": "{{blue}}",
            "fontStyle": "bold"
            }
        },
        {
            "scope": ["markup.bold"],
            "settings": {
            "foreground": "{{yellow}}",
            "fontStyle": "bold"
            }
        },
        {
            "scope": ["markup.italic"],
            "settings": {
            "foreground": "{{mauve}}",
            "fontStyle": "italic"
            }
        },
        {
            "scope": ["markup.inline.raw", "markup.fenced_code.block"],
            "settings": {
            "foreground": "{{green}}"
            }
        },
        {
            "scope": ["markup.link", "string.other.link"],
            "settings": {
            "foreground": "{{sky}}",
            "fontStyle": "underline"
            }
        },
        {
            "scope": ["markup.list"],
            "settings": {
            "foreground": "{{red}}"
            }
        },
        {
            "scope": ["markup.quote"],
            "settings": {
            "foreground": "{{overlay}}",
            "fontStyle": "italic"
            }
        },
        {
            "scope": ["diff.inserted"],
            "settings": {
            "foreground": "{{green}}"
            }
        },
        {
            "scope": ["diff.deleted"],
            "settings": {
            "foreground": "{{red}}"
            }
        },
        {
            "scope": ["diff.changed"],
            "settings": {
            "foreground": "{{yellow}}"
            }
        }
        ]
    },

    "editor.semanticTokenColorCustomizations": {
        "enabled": true,
        "rules": {
        "namespace": "{{yellow}}",
        "class": "{{yellow}}",
        "struct": "{{yellow}}",
        "interface": "{{yellow}}",
        "enum": "{{yellow}}",
        "type": "{{yellow}}",
        "typeParameter": "{{orange}}",

        "variable": "{{fg}}",
        "variable.readonly": "{{red}}",
        "property": "{{teal}}",
        "parameter": "{{orange}}",
        "parameter.readonly": "{{orange}}",

        "function": "{{blue}}",
        "method": "{{blue}}",
        "function.defaultLibrary": "{{sky}}",

        "macro": "{{red}}",
        "decorator": "{{pink}}",

        "enumMember": "{{pink}}",
        "event": "{{pink}}",

        "keyword": "{{mauve}}",
        "comment": "{{overlay}}",
        "string": "{{green}}",
        "number": "{{orange}}",
        "regexp": "{{teal}}",
        "operator": "{{fg_dim}}"
        }
